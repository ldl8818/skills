    "youtube/transcript": {
      "desc": "取 YouTube 字幕正文",
      "providers": [
        {
          "id": "ytdlp-subs",
          "type": "cli",
          "status": "active",
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "yt-dlp",
          "post": "scripts/clean-subtitles.py <actual-vtt-file>",
          "cleanup": "仅清理本任务生成的已确认路径",
          "validator": "task_sufficient_with_provenance",
          "evidence_type": "subtitles",
          "_note": "先确认人工/自动轨道及可用语言；请求语言无字幕不代表视频无字幕；不凭warning单独判成功或失败"
        },
        {
          "id": "opencli-youtube-transcript",
          "type": "opencli",
          "command": "youtube/transcript",
          "status": "conditional",
          "failure_domain": "opencli-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": [
            "url",
            "mode"
          ],
          "required_columns": [],
          "normalizer_provider": "opencli/youtube/transcript",
          "evidence_type": "subtitles",
          "validator": "task_sufficient_with_provenance",
          "_note": "先检查当前注册表与帮助；已核对实现支持 url/lang/mode，raw/grouped 模式输出不同而未声明 columns，按实际字幕文本与定位验收，不虚构固定字段",
          "_source": "https://github.com/jackwener/opencli/blob/b06ab7780e73d3021e12e0f170086c2d55675776/clis/youtube/transcript.js#L125-L139"
        },
        {
          "id": "agent-reach-transcribe",
          "type": "cli",
          "status": "conditional",
          "failure_domain": "remote-http",
          "auth": "configured-transcription-provider",
          "bin": "python3",
          "entry": "scripts/reach.py run transcribe",
          "evidence_type": "asr",
          "local_effect": "temporary-audio",
          "validator": "task_sufficient_with_provenance",
          "requires": [
            "scripts/reach.py status确认融合运行时已准备；普通查询不自动prepare",
            "已有ffmpeg/ffprobe与转写配置",
            "音频外发/费用在任务授权范围内",
            "音频可获取"
          ],
          "_note": "使用随包融合引擎，不要求独立agent-reach命令；默认只使用已选服务商，不自动配置Key、跨服务商或把ASR称为原始字幕"
        }
      ]
    },
