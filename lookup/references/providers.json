{
  "version": 5,
  "_doc": "Lookup 的必要合约与任务边界，不是完整后端目录或自动执行器。候选按数组顺序列出，仅在条件相当时参考；实际选择见 references/任务选路.md。命令参数来自当前注册表／帮助；active/conditional 是登记状态，不表示当前健康。",
  "failure_domains": {
    "_model": "分别判断浏览器进程、站点账号、bridge+Profile、site+action；只有共享实际依赖才共享故障。",
    "opencli-browser": "已选定的 browser/Profile + 站点会话 + OpenCLI bridge + 具体 adapter；按 LOOKUP_OPENCLI_PROFILE 配置，默认 ego-lite",
    "host-browser-api": "当前 Agent 实际发现的浏览器能力；是否与其他候选共享进程/Profile/账号需现场核对",
    "ego-browser-api": "正式 ego-browser Skill；仍依赖 ego lite 与其对应会话，不依赖 OpenCLI bridge/adapter",
    "direct-http": "本机直连或已配置网络路径，不依赖浏览器；仍受原站/账号/网络限制",
    "sogou": "搜狗微信搜索/跳转上游",
    "remote-http": "第三方服务，受配额、数据外发和原站可用性约束",
    "local-data": "仅用户指定的本机数据源"
  },
  "failure_classes": [
    "auth_required",
    "unsupported_action",
    "invalid_output",
    "rate_limited",
    "network",
    "bridge_profile",
    "deadline_exceeded",
    "unknown"
  ],
  "ego_browser": {
    "provider_id": "ego-browser",
    "failure_domain": "ego-browser-api",
    "invocation": "load-installed-official-skill",
    "use_when": [
      "无合适专用来源且本机日常外部网页需要浏览器",
      "用户明确指定ego环境",
      "开发或其他任务中实际能力最合适"
    ],
    "useless_when": [
      "已确认同一ego进程不可用",
      "同一站点账号认证失效或风控"
    ],
    "requires": [
      "加载与安装版本匹配的正式ego-browser Skill",
      "只操作本任务已证明归属的空间",
      "用户接管或权限拒绝后停止相关操作"
    ]
  },
  "actions": {
    "x/search": {
      "desc": "搜 X 推文",
      "providers": [
        {
          "id": "opencli-twitter-search",
          "type": "opencli",
          "command": "twitter/search",
          "status": "active",
          "failure_domain": "opencli-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": [
            "query",
            "product",
            "limit"
          ],
          "required_columns": [
            "author",
            "text",
            "created_at",
            "url"
          ],
          "policy_args": [
            {
              "name": "product",
              "value": "live",
              "when": "用户要求最新/最近/今天"
            }
          ],
          "keep_fields": [
            "author",
            "text",
            "created_at",
            "url",
            "likes",
            "views"
          ],
          "validator": "task_sufficient_with_provenance",
          "normalizer_provider": "opencli/twitter/search",
          "evidence_type": "full_text",
          "_note": "短帖正文完整且覆盖任务时直接用；线程/长文/上下文缺口才补读"
        }
      ]
    },
    "x/article": {
      "desc": "取 X 长文正文",
      "providers": [
