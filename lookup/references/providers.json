    "youtube/search": {
      "desc": "搜 YouTube 视频",
      "providers": [
        {
          "id": "ytdlp-search",
          "type": "cli",
          "status": "active",
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "yt-dlp",
          "validator": "task_sufficient_with_provenance",
