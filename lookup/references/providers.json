          "status": "conditional",
          "failure_domain": "remote-http",
          "auth": "none",
          "bin": "curl",
          "validator": "task_sufficient_with_provenance",
          "max_output_chars": 40000,
          "_note": "仅用于用户允许发送给第三方的公开 URL；认证、内网和敏感链接禁用",
          "evidence_type": "full_text"
        }
      ]
    },
