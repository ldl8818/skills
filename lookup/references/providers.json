          ],
          "validator": "task_sufficient_with_provenance",
          "evidence_type": "excerpt",
          "_note": "按 search-routing.md 的免费顺序与切换规则执行；工具名以当前 schema 为准"
        },
        {
          "id": "doubao-web-search",
          "type": "mcp-cli",
          "status": "conditional",
          "failure_domain": "remote-http",
          "auth": "protected_search_key",
          "bin": "mcporter",
          "conditional_args": [
            "需要时效时添加 max_age_days: {freshness_days}"
          ],
          "keep_fields": [
            "title",
            "url",
            "snippet",
            "published_at",
            "source"
          ],
          "validator": "task_sufficient_with_provenance",
          "evidence_type": "excerpt",
          "requires": [
            "已配置搜索专用 Key，已确认免费余额与超额停用边界"
          ]
        },
        {
          "id": "host-search-en",
          "type": "manual",
          "status": "conditional",
          "failure_domain": "remote-http",
          "evidence_type": "excerpt",
          "validator": "task_sufficient_with_provenance",
          "requires": [
