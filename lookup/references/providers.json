          "required_args": [
            "tweet-id"
          ],
          "required_columns": [
            "title",
            "author",
            "content",
            "url"
          ],
          "validator": "task_sufficient_with_provenance",
          "normalizer_provider": "opencli/twitter/article",
          "evidence_type": "full_text"
        }
      ]
    },
