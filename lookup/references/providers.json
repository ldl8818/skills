{
  "version": 5,
  "_doc": "Lookup 的必要合约与任务边界，不是完整后端目录或自动执行器。候选按数组顺序列出，仅在条件相当时参考；实际选择见 references/任务选路.md。命令参数来自当前注册表／帮助；active/conditional 是登记状态，不表示当前健康。auth 描述认证依赖类型，不证明当前是否登录；browser-session 也不要求所有动作先登录。登录准备见 references/opencli-windows.md#登录准备与恢复。",
  "failure_domains": {
    "_model": "分别判断浏览器进程、站点账号、bridge+Profile、site+action；只有共享实际依赖才共享故障。",
    "opencli-browser": "浏览器进程 + 目标账号 + 具体 adapter；Browser Bridge 固定已确认的 ego-lite contextId，不默认选择产品名别名；CDP 只接受绑定中已确认的 ego-lite endpoint",
    "host-browser-api": "当前 Agent 实际发现的浏览器能力；是否与其他候选共享进程/Profile/账号需现场核对",
    "ego-browser-api": "ego-browser 原生执行接口；仍依赖 ego lite 与其对应会话，不依赖 OpenCLI bridge/adapter",
    "direct-http": "本机直连或已配置网络路径，不依赖浏览器；仍受原站/账号/网络限制",
    "sogou": "搜狗微信搜索/跳转上游",
    "remote-http": "第三方服务，受配额、数据外发和原站可用性约束",
    "local-data": "仅用户指定的本机数据源"
  },
  "failure_classes": [
    "auth_required",
    "unsupported_action",
    "invalid_output",
    "rate_limited",
    "network",
    "bridge_profile",
    "deadline_exceeded",
    "unknown"
  ],
  "ego_browser": {
    "provider_id": "ego-browser",
    "failure_domain": "ego-browser-api",
    "invocation": "read-current-ego-browser-skill-guide",
    "use_when": [
      "无合适专用来源且本机日常外部网页需要浏览器",
      "平台抓取已满足 references/failure-domains.md#适配器修复与浏览器兜底 的条件",
      "CLI 登录准备确需该接口，且已确认它指向 CLI 原绑定的同一浏览器和 Profile；只辅助人工交接，见 references/opencli-windows.md#登录准备与恢复",
      "用户明确指定ego环境",
      "本地 Web UI 调试没有可用的 Agent 内置浏览器，或其能力不足"
    ],
    "useless_when": [
      "已确认同一ego进程不可用",
      "抓取兜底仍复用同一认证失效或风控中的站点账号；人工登录准备按独立流程交接"
    ],
    "requires": [
      "通过 ego-browser skill 读取与安装版本匹配的完整指南",
      "平台抓取不能因一次动作失败、缺参数或需要渲染直接兜底；修复与停止条件见 references/failure-domains.md#适配器修复与浏览器兜底",
      "只操作本任务已证明归属的空间",
      "用户接管或权限拒绝后停止相关操作"
    ]
  },
  "actions": {
    "x/search": {
      "desc": "搜 X 推文",
      "providers": [
        {
          "id": "opencli-twitter-search",
          "type": "opencli",
          "command": "twitter/search",
          "status": "active",
          "failure_domain": "opencli-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": [
            "query",
            "product",
            "limit"
          ],
          "required_columns": [
            "author",
            "text",
            "created_at",
            "url"
          ],
          "policy_args": [
            {
              "name": "product",
              "value": "live",
              "when": "用户要求最新/最近/今天"
            }
          ],
          "keep_fields": [
            "author",
            "text",
            "created_at",
            "url",
            "likes",
            "retweets",
            "replies",
            "quotes",
            "bookmarks",
            "views",
            "shares"
          ],
          "validator": "task_sufficient_with_provenance",
          "normalizer_provider": "opencli/twitter/search",
          "evidence_type": "full_text",
          "_note": "短帖正文完整且覆盖任务时直接用；线程/长文/上下文缺口才补读。互动指标按本地指标补丁保留，null为未提供；retweets是转帖、quotes是引用、bookmarks是书签，不能合并冒充分享数。"
        }
      ]
    },
