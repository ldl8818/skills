{
  "version": 2,
  "_doc": "lookup 的策略覆盖层。OpenCLI 的命令签名、access、strategy、browser、args、columns 以 `opencli list -f json` 为事实源；本文件只记录跨工具优先级、失效域、必要合约和结果验收，不参与运行时执行。",
  "failure_domains": {
    "_model": "L1 ego lite 进程；L2 Profile 登录态与账号风控；L3 OpenCLI daemon+扩展；L4 OpenCLI 站点适配器。ego-browser 只依赖 L1+L2，OpenCLI adapter 依赖 L1~L4。",
    "ego-lite-browser": "OpenCLI adapter：L1+L2+L3+L4",
    "ego-browser-api": "ego-browser：L1+L2",
    "direct-http": "本机进程直连目标站，不经浏览器",
    "sogou": "上游经搜狗微信搜索中转，可与 OpenCLI 浏览器依赖叠加",
    "remote-http": "第三方远端 API，受其配额、隐私边界与可用性约束"
  },
  "failure_classes": [
    "auth_required",
    "unsupported_action",
    "invalid_output",
    "rate_limited",
    "network",
    "unknown"
  ],
  "ego_browser_fallback": {
    "provider_id": "ego-browser",
    "failure_domain": "ego-browser-api",
    "invocation": "manual",
    "use_when": [
      "L3 daemon 或扩展失败",
      "L4 适配器字段缺失、空结果或解析异常"
    ],
    "useless_when": [
      "L2 AUTH_REQUIRED 或账号风控",
      "L1 ego lite 未运行或崩溃"
    ],
    "verified": {
      "youtube/search": "2026-07-29：页面内定向提取 5 条结果",
      "weixin/detail": "2026-07-30：搜狗跳转后读取公众号完整正文"
    },
    "known_failure": {
      "youtube/transcript": "页面内字幕 fetch 被扩展阻断；继续使用 yt-dlp"
    }
  },
  "interactive_only": {
    "provider": "ego-browser",
    "failure_domain": "ego-browser-api",
    "use_when": "登录扫码、验证码、多步表单、跨页面组合、无适配器的长尾站点"
  },
  "actions": {
    "x/search": {
      "desc": "搜 X 推文",
      "providers": [
        {
          "id": "opencli-twitter-search",
          "type": "opencli",
          "command": "twitter/search",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["query", "product", "limit"],
          "required_columns": ["author", "text", "created_at", "url"],
          "policy_args": [{"name": "product", "value": "live"}],
          "keep_fields": ["author", "text", "created_at", "url", "likes", "views"],
          "validator": "list_nonempty+has_time_field",
          "_verified": "2026-07-29：live 返回当天推文，top 会返回旧热门"
        }
      ]
    },
    "x/article": {
      "desc": "取 X 长文正文",
      "providers": [
        {
          "id": "opencli-twitter-article",
          "type": "opencli",
          "command": "twitter/article",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["tweet-id"],
          "required_columns": ["title", "author", "content", "url"],
          "validator": "text_nonempty"
        }
      ]
    },
    "x/thread": {
      "desc": "取 X 整串推文",
      "providers": [
        {
          "id": "opencli-twitter-thread",
          "type": "opencli",
          "command": "twitter/thread",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["tweet-id", "limit"],
          "required_columns": ["author", "text", "url"],
          "validator": "list_nonempty"
        }
      ]
    },
    "x/tweets": {
      "desc": "取指定账号最近推文",
      "providers": [
        {
          "id": "opencli-twitter-tweets",
          "type": "opencli",
          "command": "twitter/tweets",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["username", "limit"],
          "required_columns": ["author", "text", "created_at", "url"],
          "validator": "list_nonempty+has_time_field"
        }
      ]
    },
    "youtube/search": {
      "desc": "搜 YouTube 视频",
      "providers": [
        {
          "id": "ytdlp-search",
          "type": "cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "yt-dlp",
          "args": ["ytsearch{limit}:{query}", "--flat-playlist", "--print", "%(title)s\t%(channel)s\t%(duration_string)s\t%(url)s"],
          "defaults": {"limit": 5},
          "validator": "list_nonempty",
          "ignore_stderr_patterns": ["Error solving.*challenge", "Access to this API has been restricted"]
        }
      ]
    },
    "youtube/transcript": {
      "desc": "取 YouTube 字幕正文",
      "providers": [
        {
          "id": "ytdlp-subs",
          "type": "cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "yt-dlp",
          "args": ["--write-auto-sub", "--sub-lang", "{lang}", "--skip-download", "--sub-format", "vtt", "-o", "{tmpdir}/%(id)s", "{url}"],
          "defaults": {"lang": "en,zh-Hans"},
          "post": "vtt_clean",
          "cleanup": "trash_tmp",
          "validator": "text_nonempty",
          "_verified": "2026-07-29：清洗后体积减少 92%"
        }
      ]
    },
    "xhs/search": {
      "desc": "搜小红书笔记列表",
      "providers": [
        {
          "id": "opencli-xhs-search",
          "type": "opencli",
          "command": "xiaohongshu/search",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["query", "limit"],
          "required_columns": ["title", "author", "published_at", "url"],
          "keep_fields": ["title", "author", "likes", "published_at", "url"],
          "validator": "list_nonempty+has_time_field"
        }
      ]
    },
    "xhs/detail": {
      "desc": "取小红书笔记正文",
      "providers": [
        {
          "id": "opencli-xhs-note",
          "type": "opencli",
          "command": "xiaohongshu/note",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["note-id"],
          "required_columns": ["field", "value"],
          "validator": "text_nonempty"
        }
      ]
    },
    "xhs/comments": {
      "desc": "取小红书评论",
      "providers": [
        {
          "id": "opencli-xhs-comments",
          "type": "opencli",
          "command": "xiaohongshu/comments",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["note-id", "limit"],
          "required_columns": ["author", "text", "time"],
          "validator": "list_nonempty"
        }
      ]
    },
    "bilibili/search": {
      "desc": "搜 B站视频",
      "providers": [
        {
          "id": "bili-search",
          "type": "cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "bili",
          "args": ["search", "{query}", "--type", "video", "-n", "{limit}"],
          "defaults": {"limit": 5},
          "validator": "list_nonempty"
        },
        {
          "id": "opencli-bilibili-search",
          "type": "opencli",
          "command": "bilibili/search",
          "status": "active",
          "priority": 20,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["query", "limit"],
          "required_columns": ["title", "author", "url"],
          "validator": "list_nonempty"
        }
      ]
    },
    "bilibili/transcript": {
      "desc": "取 B站视频字幕",
      "providers": [
        {
          "id": "opencli-bilibili-subtitle",
          "type": "opencli",
          "command": "bilibili/subtitle",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["bvid"],
          "required_columns": ["from", "to", "content"],
          "validator": "text_nonempty"
        }
      ]
    },
    "weixin/search": {
      "desc": "搜公众号文章",
      "providers": [
        {
          "id": "opencli-weixin-search",
          "type": "opencli",
          "command": "weixin/search",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "upstream_failure_domain": "sogou",
          "auth": "none",
          "required_access": "read",
          "required_args": ["query", "limit"],
          "required_columns": ["title", "url", "summary", "publish_time"],
          "keep_fields": ["title", "summary", "publish_time", "url"],
          "validator": "list_nonempty+has_time_field"
        }
      ]
    },
    "weixin/detail": {
      "desc": "取公众号文章正文",
      "providers": [
        {
          "id": "ego-browser-weixin-dom",
          "type": "manual",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-browser-api",
          "selectors": {"title": "#activity-name", "author": "#js_name", "body": "#js_content"},
          "validator": "text_nonempty+not_nav_only"
        },
        {
          "id": "opencli-weixin-download",
          "type": "opencli",
          "command": "weixin/download",
          "status": "conditional",
          "priority": 20,
          "failure_domain": "ego-lite-browser",
          "auth": "none",
          "required_access": "read",
          "required_args": ["url", "output", "download-images"],
          "required_columns": ["title", "author", "publish_time", "status", "saved"],
          "local_effect": "write",
          "validator": "text_nonempty",
          "_note": "只在用户明确要求归档时使用；显式指定输出目录并关闭图片下载"
        },
        {
          "id": "read-fetch-sh",
          "type": "cli",
          "status": "broken",
          "priority": 90,
          "failure_domain": "direct-http",
          "bin": "bash",
          "validator": "text_nonempty+not_nav_only",
          "_note": "不要用于搜狗跳转链；2026-07-30 实测返回验证码页但 status=ok"
        }
      ]
    },
    "douyin/search": {
      "desc": "搜 Douyin 视频",
      "providers": [
        {
          "id": "opencli-douyin-search",
          "type": "opencli",
          "command": "douyin/search",
          "status": "active",
          "priority": 10,
          "failure_domain": "ego-lite-browser",
          "auth": "browser-session",
          "required_access": "read",
          "required_args": ["query", "limit"],
          "required_columns": ["desc", "author", "url"],
          "keep_fields": ["desc", "author", "url", "likes"],
          "validator": "list_nonempty",
          "freshness_provable": false
        }
      ]
    },
    "web/fetch": {
      "desc": "取任意网页正文",
      "providers": [
        {
          "id": "read-fetch-sh",
          "type": "cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "bash",
          "args": ["{HOME}/.agents/skills/read/scripts/fetch.sh", "{url}"],
          "validator": "text_nonempty+not_nav_only",
          "max_output_chars": 40000
        },
        {
          "id": "jina-reader",
          "type": "http",
          "status": "active",
          "priority": 20,
          "failure_domain": "remote-http",
          "auth": "none",
          "bin": "curl",
          "args": ["-fsSL", "https://r.jina.ai/{url}"],
          "validator": "text_nonempty+not_nav_only",
          "max_output_chars": 40000,
          "_note": "URL 会发送给第三方；敏感链接禁用"
        }
      ]
    },
    "web/search/en": {
      "desc": "英文语义搜索",
      "providers": [
        {
          "id": "exa-mcp",
          "type": "mcp-cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "remote-http",
          "auth": "none",
          "bin": "mcporter",
          "args": ["call", "exa.web_search_exa(query: \"{query}\", numResults: {limit})"],
          "defaults": {"limit": 3},
          "validator": "text_nonempty"
        }
      ]
    },
    "web/search/zh": {
      "desc": "中文全网搜索",
      "providers": [
        {
          "id": "doubao-web-search",
          "type": "mcp-cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "remote-http",
          "auth": "key_in_mcporter_env",
          "bin": "mcporter",
          "args": ["call", "huashu-doubao-search.doubao_search(query: \"{query}\", count: {limit})"],
          "defaults": {"limit": 5},
          "conditional_args": ["需要时效时添加 max_age_days: {freshness_days}"],
          "keep_fields": ["title", "url", "snippet", "published_at", "source"],
          "validator": "list_nonempty+has_time_field"
        }
      ]
    },
    "web/ai-news": {
      "desc": "AI 圈资讯聚合",
      "providers": [
        {
          "id": "aihot-api",
          "type": "http",
          "status": "active",
          "priority": 10,
          "failure_domain": "remote-http",
          "auth": "none",
          "bin": "curl",
          "args": ["-fsSL", "https://aihot.virxact.com/api/v1/items?mode=selected&window={window}&limit={limit}"],
          "defaults": {"limit": 10, "window": "24h"},
          "keep_fields": ["score", "title", "source.name", "url"],
          "validator": "list_nonempty",
          "freshness_provable": false
        }
      ]
    },
    "local/history": {
      "desc": "检索本机浏览器书签与历史",
      "providers": [
        {
          "id": "find-url-mjs",
          "type": "cli",
          "status": "active",
          "priority": 10,
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "node",
          "args": ["{SKILL_DIR}/scripts/find-url.mjs", "{query}"],
          "validator": "list_nonempty"
        }
      ]
    }
  }
}
