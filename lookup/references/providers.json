          "validator": "task_sufficient_with_provenance",
          "evidence_type": "excerpt"
        },
        {
          "id": "tavily-mcp",
          "type": "mcp-cli",
          "status": "conditional",
          "failure_domain": "remote-http",
          "auth": "oauth_or_keyless_header",
          "bin": "mcporter",
          "requires": [
            "优先已授权账号入口 tavily-account；没有账号入口时才用官方带 Keyless Header 的 tavily 别名"
          ],
          "policy_args": [
            {
              "name": "search_depth",
              "value": "basic",
              "when": "普通搜索"
