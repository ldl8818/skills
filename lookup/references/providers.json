    "web/fetch": {
      "desc": "取任意网页正文",
      "providers": [
        {
          "id": "lookup-fetch-sh",
          "type": "cli",
          "status": "active",
          "failure_domain": "direct-http",
          "auth": "none",
          "bin": "bash",
          "_note": "从 Lookup 根目录执行；仅请求原站，HTML/纯文本/Markdown分别提取，stdout含最终Source URL，stderr为状态JSON",
          "normalizer_provider": "lookup/fetch",
          "exit_codes": {
            "0": "ok",
            "3": "partial",
