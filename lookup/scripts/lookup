#!/usr/bin/env python3
"""User-facing entry point, also usable through a symlink in a user bin directory."""
import runpy
import signal
import sys
from pathlib import Path

namespace = runpy.run_path(str(Path(__file__).resolve().with_name('upstream.py')))
def interrupted(signum, frame):
    raise KeyboardInterrupt
signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGHUP, interrupted)
sys.exit(namespace['main'](human=True))
